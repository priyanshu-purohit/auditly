# Auditly — environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. NEVER commit real keys.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Credit safety switch
# ---------------------------------------------------------------------------
# "true"  = never call ElevenLabs; return a saved transcript instead. FREE.
# "false" = really call ElevenLabs. Costs about 28 credits per 5-second clip.
#
# Keep this "true" while building. Only set it to "false" when you are
# deliberately testing real speech, because the free plan gives you just
# 10,000 credits per month (~30 minutes of audio) in total.
AUDITLY_MOCK_VOICE=true

# ---------------------------------------------------------------------------
# Your shop
# ---------------------------------------------------------------------------
# The name shown at the top of the app. Change it here and reload the page.
# Leave empty to use "Meri Dukaan".
AUDITLY_SHOP_NAME=

# ---------------------------------------------------------------------------
# ElevenLabs — speech to text (and later, text to speech)
# ---------------------------------------------------------------------------
# Get a key: elevenlabs.io -> Developers (sidebar) -> API Keys -> create.
# When creating it, SET A MONTHLY CREDIT LIMIT (e.g. 2000) so a bug cannot
# drain your whole month.
ELEVENLABS_API_KEY=

# Transcription model. scribe_v2 is current; scribe_v1 is deprecated.
ELEVENLABS_STT_MODEL=scribe_v2

# Language hint. "hi" for Hindi/Hinglish. Leave empty to let ElevenLabs
# auto-detect, which can work better for heavily mixed Hinglish.
ELEVENLABS_LANGUAGE_CODE=hi

# Text to speech — the app reading your day back.
# "true"  = the browser speaks. FREE, works offline, sounds robotic.
# "false" = ElevenLabs speaks. Costs about 1 credit per character
#           (a summary is roughly 150 credits). Needs ELEVENLABS_VOICE_ID.
AUDITLY_MOCK_SPEECH=true

# Voice to speak with. REQUIRED for real ElevenLabs speech.
# On the free plan ElevenLabs refuses *library* voices over the API, so this
# must be a voice that exists in your own account. Find it at
# elevenlabs.io -> Voices -> pick one -> copy its ID.
ELEVENLABS_VOICE_ID=

# Speech model. eleven_multilingual_v2 handles Hindi.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Groq — free hosted LLM that turns the transcript into records (day 3)
# ---------------------------------------------------------------------------
# Get a key at console.groq.com. Free, no credit card.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# MongoDB Atlas (day 4)
# ---------------------------------------------------------------------------
# Atlas -> Cluster -> Connect -> Drivers. Looks like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true
MONGODB_URI=
MONGODB_DB=auditly
